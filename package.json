{
  "name": "linux-pdf",
  "version": "1.0.0",
  "description": "Professional Linux PDF Suite for Linux and Windows",
  "author": "Linux PDF Contributors",
  "main": "electron/main.cjs",
  "bin": {
    "linux-pdf": "electron/main.cjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "linux:serve": "node electron/main.cjs --web",
    "linux:web": "node electron/main.cjs --web",
    "pack:linux": "electron-builder --linux",
    "pack:appimage": "electron-builder --linux AppImage",
    "pack:deb": "electron-builder --linux deb",
    "pack:tar": "electron-builder --linux tar.gz",
    "build:linux": "vite build && electron-builder --linux AppImage deb tar.gz",
    "build:linux:all": "electron-builder --linux AppImage deb tar.gz",
    "build:exe": "vite build && electron-builder --win portable nsis",
    "build:portable": "vite build && electron-builder --win portable",
    "build:installer": "vite build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.linuxpdf.app",
    "productName": "Linux PDF",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Office",
      "icon": "assets/icon.png",
      "synopsis": "Full-featured Linux PDF Suite",
      "description": "Complete PDF Editor, Viewer, Form Filler, OCR, and Organizer.",
      "desktop": {
        "Name": "Linux PDF",
        "Type": "Application",
        "Exec": "linux-pdf %U",
        "Icon": "linux-pdf",
        "Categories": "Office;Viewer;Publishing;",
        "MimeType": "application/pdf;application/vnd.adobe.pdf;application/x-pdf;"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Adobe Acrobat Pro"
    },
    "portable": {
      "artifactName": "Adobe Acrobat Pro Portable.exe"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}